# Copy to .env and fill in what you need. Everything is optional except the
# two keys at the top, and even without them the demo data and UI work.

# ---- Required for the real meeting flow ----------------------------------
# https://app.meetstream.ai/api-key
MEETSTREAM_API_KEY=
# Transcript analysis: set ONE of these (Claude is used if both are set,
# unless ANALYSIS_PROVIDER says otherwise).
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional: public URL ------------------------------------------------
# A public HTTPS address forwarding to the backend (port 8000), e.g. from
#   ngrok http 8000      or      cloudflared tunnel --url http://localhost:8000
# With it, MeetStream pushes webhooks (faster status, participant joins) and the
# stand-up agent can look people up live. Without it, everything works by polling.
PUBLIC_URL=
# Only for workspace webhooks configured in the MeetStream dashboard (signed deliveries).
MEETSTREAM_WEBHOOK_SECRET=

# ---- Bot behaviour --------------------------------------------------------
BOT_NAME=MeetPact AI Notetaker
# meetstream | deepgram | assemblyai - post-call providers. Depending on your
# MeetStream account, the provider's key may need adding in the MeetStream dashboard;
# a missing key shows up as "MeetStream could not transcribe this meeting".
TRANSCRIPT_PROVIDER=meetstream
# en, es, ... ("auto" lets the meetstream provider detect the language)
TRANSCRIPT_LANGUAGE=en
RETENTION_HOURS=168
WAITING_ROOM_TIMEOUT=600
EVERYONE_LEFT_TIMEOUT=120
# Seconds an admitted bot waits for anyone else to arrive, e.g. a late host (60-1800)
NO_ONE_JOINED_TIMEOUT=600
# Signed-in Google Meet bot (optional): joins without knocking when its account is on the
# calendar invite and the meeting is Trusted or Restricted. Needs a Google Workspace domain of
# bot accounts registered with MeetStream (docs/configuration.md). Empty: the bot joins as a guest.
# GOOGLE_BOT_LOGIN_DOMAIN=bots.example.com
# GOOGLE_BOT_SIGN_IN_EMAIL=notetaker@bots.example.com
# GOOGLE_BOT_STRICT_EMAIL=true
# Minutes before a scheduled meeting that the bot is booked with MeetStream (join_at)
SCHEDULE_LEAD_MINUTES=10
EARLY_JOIN_MINUTES=2
# Default timezone for new schedules (IANA name)
TIMEZONE=UTC

# ---- AI stand-up mode (MeetStream MIA voice agent) ---------------------------
# There is no default voice: an admin picks one in the app (Admin, Setup guide, Stand-up voice),
# and stand-ups can't be booked until then. Every voice runs on your own provider key, added in
# MeetStream under Configure -> Integrations. To choose here instead (headless installs), set e.g.
# MIA_MODEL_PROVIDER=google MIA_VOICE=Puck, or for a pipeline agent MIA_MODE=pipeline
# MIA_MODEL_PROVIDER=anthropic MIA_MODEL=claude-sonnet-4-5 MIA_VOICE_PROVIDER=elevenlabs MIA_VOICE=<voice id>
# MIA_MODE=realtime
# MIA_MODEL_PROVIDER=
# MIA_MODEL=
# MIA_VOICE_PROVIDER=openai
# MIA_VOICE=
MIA_TRANSCRIBER_PROVIDER=deepgram
MIA_TRANSCRIBER_MODEL=nova-3

# ---- Transcript analysis ------------------------------------------------------
# gemini | anthropic | openai | xai (empty = the first one with a key)
ANALYSIS_PROVIDER=
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=high
# gemini-2.5-pro was the most accurate in testing; gemini-3.8-flash is faster
GEMINI_MODEL=gemini-2.5-pro
# OpenAI or Grok (xAI) for the notes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
XAI_API_KEY=
XAI_MODEL=grok-4

# ---- Task-tool integrations (each one is enabled by setting its variables) ----
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
# Cards moved to this list count as done
TRELLO_DONE_LIST_ID=

MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_STATUS_COLUMN_ID=status

INTEGRATION_SYNC_MINUTES=15

# ---- Server ---------------------------------------------------------------------
# DATABASE_URL=sqlite:///backend/data/tracker.db   (default)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/tracker   (install psycopg first)
# SECRET_KEY=   (signs session cookies; generated automatically when empty)

# ---- Google Calendar sign-in (optional) -----------------------------------------
# OAuth "Web application" client for Schedules -> Connect Google Calendar.
# Redirect URI to register: http://localhost:8000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   (only if you use another host or port)

# ---- Report delivery after each meeting (optional) -------------------------------
# Links in emails / Slack point here (http://localhost:8000 when using Docker)
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail: smtp.gmail.com, port 587, and an app password (not your normal password)
SMTP_FROM=
SMTP_STARTTLS=true
# Slack incoming webhook URL
SLACK_WEBHOOK_URL=
